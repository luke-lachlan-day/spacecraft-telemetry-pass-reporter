<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Telemetry Pass Report — {{ report.spacecraft }} / {{ report.pass_id }}</title>
  <style>
    :root {
      color-scheme: light;
      --ink: #182230;
      --muted: #526071;
      --line: #d7dee7;
      --surface: #ffffff;
      --surface-alt: #f4f7fa;
      --brand: #17486f;
      --brand-soft: #e8f1f7;
      --nominal: #17663a;
      --nominal-soft: #e8f5ed;
      --warning: #7a4b00;
      --warning-soft: #fff3d6;
      --critical: #9d2028;
      --critical-soft: #fdebed;
      --shadow: 0 16px 44px rgba(28, 45, 66, 0.09);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      background: #edf2f6;
      color: var(--ink);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-size: 16px;
      line-height: 1.55;
    }

    .page {
      width: min(1180px, calc(100% - 32px));
      margin: 32px auto;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    header {
      padding: 36px 40px 30px;
      color: #ffffff;
      background: linear-gradient(125deg, #12354f 0%, #1a527b 75%, #24638e 100%);
    }

    .eyebrow {
      margin: 0 0 8px;
      color: #c7deee;
      font-size: 0.76rem;
      font-weight: 750;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: 18px; font-size: clamp(1.75rem, 4vw, 2.55rem); line-height: 1.15; }
    h2 { margin-bottom: 16px; font-size: 1.35rem; line-height: 1.25; }
    h3 { margin-bottom: 12px; font-size: 1.05rem; }

    .header-grid {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
    }

    .identity {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, auto));
      gap: 10px 28px;
      margin: 0;
    }

    .identity div { min-width: 0; }
    .identity dt { color: #c7deee; font-size: 0.76rem; font-weight: 700; text-transform: uppercase; }
    .identity dd { margin: 2px 0 0; font-weight: 650; overflow-wrap: anywhere; }

    .status-badge, .table-status, .metric-status {
      display: inline-flex;
      align-items: center;
      gap: 0.42rem;
      border: 1px solid currentColor;
      border-radius: 999px;
      font-weight: 750;
      line-height: 1;
      white-space: nowrap;
    }

    .status-badge { padding: 10px 15px; background: #ffffff; font-size: 0.9rem; }
    .status-badge::before, .table-status::before, .metric-status::before { font-size: 0.8em; }
    .nominal { color: var(--nominal); background: var(--nominal-soft); }
    .warning { color: var(--warning); background: var(--warning-soft); }
    .critical { color: var(--critical); background: var(--critical-soft); }
    .nominal::before { content: "✓"; }
    .warning::before { content: "▲"; }
    .critical::before { content: "!"; }

    main { padding: 36px 40px 42px; }
    section + section { margin-top: 38px; }

    .summary-panel {
      display: grid;
      grid-template-columns: minmax(0, 1.65fr) minmax(260px, 1fr);
      gap: 22px;
      align-items: stretch;
    }

    .operational-summary {
      padding: 22px 24px;
      border-left: 4px solid var(--brand);
      border-radius: 8px;
      background: var(--brand-soft);
    }

    .operational-summary p { margin: 0; color: #273f52; font-size: 1.04rem; }

    .count-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }

    .count-card {
      padding: 16px 12px;
      border: 1px solid var(--line);
      border-radius: 9px;
      text-align: center;
    }

    .count-card strong { display: block; font-size: 1.65rem; line-height: 1.1; }
    .count-card span { color: var(--muted); font-size: 0.78rem; font-weight: 700; text-transform: uppercase; }

    .metric-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }

    .metric-card {
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface);
    }

    .metric-card h3 { margin-bottom: 3px; }
    .unit-label { color: var(--muted); font-size: 0.84rem; }

    .stat-list {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      margin: 18px 0;
    }

    .stat-list div { padding: 10px 8px; border-radius: 7px; background: var(--surface-alt); }
    .stat-list dt { color: var(--muted); font-size: 0.72rem; font-weight: 700; text-transform: uppercase; }
    .stat-list dd { margin: 2px 0 0; font-size: 1.05rem; font-weight: 750; }

    .threshold { margin: 0; color: var(--muted); font-size: 0.82rem; }

    .event-list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .event-item {
      display: grid;
      grid-template-columns: auto minmax(150px, 1fr) minmax(190px, 1.4fr);
      gap: 14px;
      align-items: center;
      padding: 13px 15px;
      border: 1px solid var(--line);
      border-left-width: 4px;
      border-radius: 8px;
    }
    .event-item.warning { border-left-color: var(--warning); }
    .event-item.critical { border-left-color: var(--critical); }
    .event-item::before { content: none; }
    .event-time { color: var(--muted); font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.82rem; }
    .event-value { font-weight: 750; }
    .empty-events { padding: 20px; border: 1px dashed #9bb1c0; border-radius: 8px; color: var(--muted); background: var(--surface-alt); }

    .table-wrapper { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; }
    table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    caption { padding: 13px 16px; color: var(--muted); background: var(--surface-alt); text-align: left; font-size: 0.84rem; }
    th, td { padding: 12px 14px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: middle; }
    th { color: #33475a; background: #f2f6f9; font-size: 0.76rem; letter-spacing: 0.03em; text-transform: uppercase; }
    tr:last-child td { border-bottom: 0; }
    tbody tr:hover { background: #f8fafc; }
    .timestamp { min-width: 225px; color: #3f5061; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.82rem; }
    .metric-value { display: block; font-weight: 680; white-space: nowrap; }
    .metric-status { margin-top: 4px; padding: 4px 7px; font-size: 0.68rem; }
    .table-status { padding: 6px 9px; font-size: 0.72rem; }

    .legend {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 22px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
      color: var(--muted);
      font-size: 0.84rem;
    }
    .legend strong { color: var(--ink); }

    footer {
      padding: 20px 40px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      background: var(--surface-alt);
      font-size: 0.82rem;
      text-align: center;
    }
    footer p { margin: 0; }

    @media (max-width: 820px) {
      .page { width: min(100% - 20px, 1180px); margin: 10px auto; border-radius: 10px; }
      header, main { padding-left: 22px; padding-right: 22px; }
      .header-grid { align-items: start; flex-direction: column; }
      .identity { grid-template-columns: 1fr; }
      .summary-panel, .metric-grid { grid-template-columns: minmax(0, 1fr); }
      .summary-panel > *, .metric-card { min-width: 0; }
      .event-item { grid-template-columns: 1fr; gap: 3px; }
    }

    @media print {
      body { background: #ffffff; }
      .page { width: 100%; margin: 0; border: 0; box-shadow: none; }
      header { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
      .table-wrapper { overflow: visible; }
      tr, .metric-card, .event-item { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="page">
    <header>
      <p class="eyebrow">Telemetry pass analysis</p>
      <h1>Spacecraft Telemetry Pass Report</h1>
      <div class="header-grid">
        <dl class="identity">
          <div>
            <dt>Spacecraft</dt>
            <dd>{{ report.spacecraft }}</dd>
          </div>
          <div>
            <dt>Pass ID</dt>
            <dd>{{ report.pass_id }}</dd>
          </div>
          <div>
            <dt>Started</dt>
            <dd>{{ report.started_at }}</dd>
          </div>
        </dl>
        <span class="status-badge {{ report.overall_status }}" aria-label="Overall status: {{ report.overall_status_label }}">
          Overall: {{ report.overall_status_label }}
        </span>
      </div>
    </header>

    <main>
      <section aria-labelledby="summary-heading">
        <h2 id="summary-heading">Pass summary</h2>
        <div class="summary-panel">
          <div class="operational-summary">
            <h3>Operational summary</h3>
            <p>{{ report.operational_summary }}</p>
          </div>
          <div class="count-grid" aria-label="Reading counts by severity">
            <div class="count-card nominal"><strong>{{ report.nominal_count }}</strong><span>Nominal</span></div>
            <div class="count-card warning"><strong>{{ report.warning_count }}</strong><span>Warning</span></div>
            <div class="count-card critical"><strong>{{ report.critical_count }}</strong><span>Critical</span></div>
          </div>
        </div>
      </section>

      <section aria-labelledby="statistics-heading">
        <h2 id="statistics-heading">Metric statistics and limits</h2>
        <div class="metric-grid">
          {% for metric in report.metric_summaries %}
          <article class="metric-card">
            <h3>{{ metric.label }}</h3>
            <span class="unit-label">Values in {{ metric.unit }}</span>
            <dl class="stat-list">
              <div><dt>Minimum</dt><dd>{{ metric.minimum }}</dd></div>
              <div><dt>Average</dt><dd>{{ metric.average }}</dd></div>
              <div><dt>Maximum</dt><dd>{{ metric.maximum }}</dd></div>
            </dl>
            <p class="threshold"><strong>{{ metric.direction|title }} rule:</strong> {{ metric.threshold_description }}.</p>
          </article>
          {% endfor %}
        </div>
      </section>

      <section aria-labelledby="events-heading">
        <h2 id="events-heading">Warning and critical events</h2>
        {% if report.events %}
        <ol class="event-list">
          {% for event in report.events %}
          <li class="event-item {{ event.status }}">
            <span class="table-status {{ event.status }}">{{ event.status_label }}</span>
            <time class="event-time">{{ event.timestamp }}</time>
            <span><strong>{{ event.metric_label }}</strong> — <span class="event-value">{{ event.value }} {{ event.unit }}</span></span>
          </li>
          {% endfor %}
        </ol>
        {% else %}
        <p class="empty-events">No warning or critical metric events were recorded during this pass.</p>
        {% endif %}
      </section>

      <section aria-labelledby="readings-heading">
        <h2 id="readings-heading">Chronological telemetry</h2>
        <div class="table-wrapper">
          <table>
            <caption>{{ report.total_readings }} readings, ordered from pass start. Each metric includes a written severity label.</caption>
            <thead>
              <tr>
                <th scope="col">Timestamp</th>
                <th scope="col">Battery voltage (V)</th>
                <th scope="col">Temperature (°C)</th>
                <th scope="col">Signal strength (dBm)</th>
                <th scope="col">Reading status</th>
              </tr>
            </thead>
            <tbody>
              {% for reading in report.readings %}
              <tr>
                <td class="timestamp"><time>{{ reading.timestamp }}</time></td>
                {% for metric in reading.metrics %}
                <td>
                  <span class="metric-value">{{ metric.value }} {{ metric.unit }}</span>
                  <span class="metric-status {{ metric.status }}">{{ metric.status_label }}</span>
                </td>
                {% endfor %}
                <td><span class="table-status {{ reading.status }}">{{ reading.status_label }}</span></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <ul class="legend" aria-label="Severity legend">
          <li><strong>✓ Nominal:</strong> inside configured warning limits</li>
          <li><strong>▲ Warning:</strong> at or beyond a warning threshold</li>
          <li><strong>! Critical:</strong> at or beyond a critical threshold</li>
        </ul>
      </section>
    </main>

    <footer>
      <p>This report uses fictional demonstration data for software-engineering education. It is not a complete spacecraft-operations system and is not intended for mission use.</p>
    </footer>
  </div>
</body>
</html>
